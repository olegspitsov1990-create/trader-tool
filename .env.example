# Trader Tool – Zugangsdaten für den Live-Modus auf dem PC
# Diese Datei heißt nach dem ersten Start ".env" und bleibt nur auf deinem PC (wird nie hochgeladen).

# E-Mail (Gmail: App-Passwort, 16 Buchstaben)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Alpaca (kostenlos, nur Marktdaten): https://alpaca.markets -> Konto -> API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
